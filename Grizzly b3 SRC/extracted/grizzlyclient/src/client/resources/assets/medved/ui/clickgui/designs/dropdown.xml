<templates>
    <template name="dropdown-mode">
        <scroll w="fill" h="fill" bg="{{theme.bg}}" scrollKey="dropdown" scrollY="{{scroll.dropdown}}" scrollAmount="24" scrollbarTrackBg="{{theme.divider}}" scrollbarThumbBg="{{theme.textDim}}">
            <component name="config-panel" />
            <for each="categories">
                <component name="category-panel" />
            </for>
        </scroll>
    </template>

    <template name="config-panel">
        <panel x="{{config.x}}" y="{{config.y}}" w="176" padding="0" gap="0" radius="6" bg="{{theme.panelBg}}" border="{{theme.borderSoft}}" borderWidth="1" blur="{{theme.panelBlur}}" blurTint="{{theme.glassTint}}" blurStrength="7" shadow="4" shadowColor="{{theme.shadow}}">
            <row id="config:header" axis="horizontal" w="fill" h="20" fg="{{theme.text}}" bg="{{theme.headerBg}}" padding="0" gap="0" radius="6" corners="top">
                <row w="20" h="20" bg="{{theme.transparent}}" padding="0" />
                <row text="CONFIGS" w="fill" h="20" fg="{{theme.text}}" bg="{{theme.transparent}}" align="center" padding="0" />
                <row text="{{config.sign}}" w="20" h="20" fg="{{theme.textDim}}" bg="{{theme.transparent}}" align="center" padding="0" font="minecraft" />
            </row>
            <if condition="config.expanded">
                <box w="fill" padding="0" gap="0">
                    <box w="fill" h="1" bg="{{theme.divider}}" padding="0" gap="0" />
                    <box w="fill" padding="6 6" gap="5">
                        <text-input id="config:preset-input" text="{{preset.input}}" w="fill" h="15" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.controlActiveBg}}" padding="5 3" radius="3" active="{{preset.active}}" cursor="{{preset.cursor}}" scroll="{{preset.scroll}}" />
                        <box axis="horizontal" w="fill" h="17" padding="0" gap="4">
                            <row id="config:save" text="Save" w="fill" h="17" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entrySelectedBg}}" border="{{theme.borderSoft}}" borderWidth="1" align="center" padding="0" radius="3" />
                            <row id="config:load" text="Load" w="fill" h="17" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entrySelectedBg}}" border="{{theme.borderSoft}}" borderWidth="1" align="center" padding="0" radius="3" />
                            <row id="config:folder" text="Folder" w="fill" h="17" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entrySelectedBg}}" border="{{theme.borderSoft}}" borderWidth="1" align="center" padding="0" radius="3" />
                        </box>
                        <if condition="presets.empty">
                            <row text="(no presets saved)" w="fill" h="15" fg="{{theme.textDim}}" bg="{{theme.transparent}}" padding="3 3" />
                        </if>
                        <if condition="presets.present">
                            <for each="presets" w="fill" gap="1">
                                <row id="{{preset.id}}" text="{{preset.name}}" w="fill" h="15" fg="{{preset.fg}}" bg="{{preset.bg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 3" radius="3" />
                            </for>
                        </if>

                        <if condition="meta.open">
                            <box w="fill" h="1" bg="{{theme.divider}}" padding="0" gap="0" />
                            <box w="fill" padding="0" gap="3">
                                <row text="{{meta.name}}" w="fill" h="14" fg="{{theme.text}}" bg="{{theme.transparent}}" padding="2 0" />

                                <row text="anticheat" w="fill" h="11" fg="{{theme.textDim}}" bg="{{theme.transparent}}" padding="2 0" />
                                <text-input id="config:meta:anticheat" text="{{meta.anticheat}}" w="fill" h="15" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.controlActiveBg}}" padding="5 3" radius="3" active="{{meta.anticheat-active}}" cursor="{{meta.cursor}}" scroll="{{meta.scroll}}" />

                                <row text="description" w="fill" h="11" fg="{{theme.textDim}}" bg="{{theme.transparent}}" padding="2 0" />
                                <text-input id="config:meta:description" text="{{meta.description}}" w="fill" h="15" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.controlActiveBg}}" padding="5 3" radius="3" active="{{meta.description-active}}" cursor="{{meta.cursor}}" scroll="{{meta.scroll}}" />

                                <row text="servers" w="fill" h="11" fg="{{theme.textDim}}" bg="{{theme.transparent}}" padding="2 0" />
                                <if condition="meta.servers.present">
                                    <for each="meta-servers" w="fill" gap="1">
                                        <row id="{{meta.server.id}}" text="{{meta.server}}" w="fill" h="14" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 2" radius="3" />
                                    </for>
                                </if>
                                <text-input id="config:meta:server" text="{{meta.server-input}}" w="fill" h="15" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.controlActiveBg}}" padding="5 3" radius="3" active="{{meta.server-active}}" cursor="{{meta.cursor}}" scroll="{{meta.scroll}}" />

                                <row text="categories saved" w="fill" h="11" fg="{{theme.textDim}}" bg="{{theme.transparent}}" padding="2 0" />
                                <for each="meta-categories" w="fill" gap="1">
                                    <row id="{{meta.category.id}}" text="{{meta.category.name}}" w="fill" h="13" fg="{{meta.category.fg}}" bg="{{meta.category.bg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 2" radius="3" />
                                </for>

                                <row id="config:meta:overwrite" text="{{meta.overwrite.label}}" w="fill" h="14" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 2" radius="3" />
                                <row id="config:meta:disable" text="{{meta.disable.label}}" w="fill" h="14" fg="{{theme.text}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 2" radius="3" />
                                <row id="config:meta:delete" text="delete config" w="fill" h="14" fg="{{theme.textDim}}" bg="{{theme.controlBg}}" hoverBg="{{theme.entryHoverBg}}" padding="5 2" radius="3" />
                            </box>
                        </if>

                    </box>
                </box>
            </if>
        </panel>
    </template>

    <template name="category-panel">
        <panel x="{{category.x}}" y="{{category.y}}" w="176" padding="0" gap="0" radius="6" bg="{{theme.panelBg}}" border="{{theme.borderSoft}}" borderWidth="1" blur="{{theme.panelBlur}}" blurTint="{{theme.glassTint}}" blurStrength="7" shadow="4" shadowColor="{{theme.shadow}}">
            <row id="{{category.id}}" axis="horizontal" w="fill" h="20" fg="{{theme.text}}" bg="{{theme.headerBg}}" padding="0" gap="0" radius="6" corners="top">
                <row w="20" h="20" bg="{{theme.transparent}}" padding="0" />
                <row text="{{category.name}}" w="fill" h="20" fg="{{theme.text}}" bg="{{theme.transparent}}" align="center" padding="0" />
                <row text="{{category.sign}}" w="20" h="20" fg="{{theme.textDim}}" bg="{{theme.transparent}}" align="center" padding="0" font="minecraft" />
            </row>
            <if condition="category.expanded">
                <box w="fill" padding="0" gap="0">
                    <box w="fill" h="1" bg="{{theme.divider}}" padding="0" gap="0" />
                    <for each="modules">
                        <component name="module-row" />
                        <if condition="module.expanded">
                            <box w="fill" padding="6 2" gap="1">
                                <for each="settings" w="fill" gap="1">
                                    <component name="{{setting.template}}" />
                                </for>
                                <if condition="module.supports-profiles">
                                    <component name="module-profiles" />
                                </if>
                            </box>
                        </if>
                    </for>
                </box>
            </if>
        </panel>
    </template>

    <template name="module-row">
        <row id="{{module.id}}" axis="horizontal" w="fill" h="18" bg="{{module.bg}}" hoverBg="{{module.hoverBg}}" padding="0" gap="0">
            <row text="{{module.name}}" w="fill" h="fill" fg="{{module.fg}}" bg="{{theme.transparent}}" padding="8 0" />
            <row text="{{module.sign}}" w="16" h="fill" fg="{{module.signFg}}" bg="{{theme.transparent}}" align="center" padding="0" font="minecraft" />
        </row>
    </template>

</templates>
